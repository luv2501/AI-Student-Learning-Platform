# Leave empty in development (the Vite proxy forwards /api to the server).
# In production set the deployed API URL, e.g. https://filesense-api.onrender.com/api
VITE_API_URL=

# Vite Dev Server Proxy Target (optional, defaults to http://localhost:5000)
# Used in development to route /api requests to the backend server.
VITE_PROXY_TARGET=http://localhost:5000
