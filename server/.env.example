# Server
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/studymind?retryWrites=true&w=majority

# Auth (phase 2)
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# AI provider (phase 4) — required for notes / flashcards / quiz / ask
# Any OpenAI-compatible chat-completions API works. Groq example:
#   AI_API_KEY=<your Groq API key>
#   AI_BASE_URL=https://api.groq.com/openai/v1   <- must end in /v1
#   AI_MODEL=openai/gpt-oss-20b                  <- must be a model the provider lists
#   AI_AUTH_STYLE=bearer                         <- Groq uses Authorization: Bearer
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_AUTH_STYLE=bearer
AI_MODEL=openai/gpt-oss-20b

# File Storage
# Directory where uploaded lecture PDFs are stored on disk (optional, defaults to server/uploads)
UPLOAD_DIR=
