{
  "name": "ai-student-learning-platform",
  "version": "0.1.0",
  "private": true,
  "description": "FileSense - Understand every document",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "test": "node server/scripts/run-all-tests.js",
    "test:server": "node server/scripts/run-all-tests.js",
    "build": "npm --prefix client run build",
    "build:client": "npm --prefix client run build"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
